# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=jetson_stream
POSTGRES_USER=jetson_stream
POSTGRES_PASSWORD=jetson_stream
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Channels layer)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT_URL=http://localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=recordings
MINIO_USE_SSL=False

# !! AUTH CURRENTLY DISABLED BY DEFAULT (True) !!
# Every REST call and both WebSocket connections skip real authentication
# while this is True — no valid JWT or device token required anywhere
# (see streaming/authentication.py DisabledAuthAuthentication,
# streaming/auth.py TokenAuthMiddleware). Local/LAN testing convenience
# only — set to False before any non-trusted deployment.
AUTH_DISABLED=True

# The one Jetson (single-device deployment — no Device DB model/API, see
# streaming/services.py). JETSON_AUTH_TOKEN is the shared secret the Jetson
# presents on ws/jetson/<device_id>/?token=... and on
# Authorization: Device <token> for recording uploads. Change both in
# production; JETSON_AUTH_TOKEN especially — the default below is not secret.
JETSON_DEVICE_ID=JETSON001
JETSON_AUTH_TOKEN=changeme-dev-token
